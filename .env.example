# Database
DATABASE_URL="file:./dev.db"

# JWT Secret - CHANGE THIS IN PRODUCTION!
# Generate a random secret with: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI Story Generation (Optional - only needed for AI features)
# Get your Anthropic API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-..."

# Get your OpenAI API key from: https://platform.openai.com/api-keys
# Used for DALL-E cover image generation (optional)
OPENAI_API_KEY="sk-..."

# Get your OpenRouter API key from: https://openrouter.ai/keys
# Used for Scorching-tier story generation (generation hard-fails if unset - no Claude fallback)
OPENROUTER_API_KEY="sk-or-..."

# Random secret used to authenticate Vercel Cron requests to /api/cron/*
# Generate with: openssl rand -hex 32
CRON_SECRET="..."

# Optional: Add your service API keys below
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_PUBLISHABLE_KEY="pk_test_..."
# RESEND_API_KEY="re_..."
